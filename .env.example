PROXMOX_URL=https://pve.example.com:8006
PROXMOX_TOKEN_ID=mcp@pve!assistant
PROXMOX_TOKEN_SECRET=replace-with-the-secret-shown-on-token-creation
PROXMOX_VERIFY_TLS=true
PROXMOX_TIMEOUT_MS=120000
# Colon-separated absolute directories on macOS/Linux; semicolon-separated on Windows.
PROXMOX_FILE_ROOTS=/absolute/path/allowed-for-uploads-and-downloads
# PROXMOX_CA_FILE=/absolute/path/to/pve-root-ca.pem
# PROXMOX_ALLOW_INSECURE_HTTP=false
# PROXMOX_SCHEMA_URL=https://pve.proxmox.com/pve-docs/api-viewer/apidoc.js
